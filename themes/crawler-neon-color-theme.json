  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8B7F88",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FC7E03"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#F4206E"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F3FB04"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F3FB04"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FB03D6"
      }
    },
    {
      "name": "Control keyword",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FB03D5"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#F4206E"
      }
    },
    {
      "name": "Function definition",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#03FBC6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function call",
      "scope": [
        "meta.function-call",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#03FBC7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class and type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B455F0"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#02FB03"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FAC234"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F5EFE3"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#FAC234",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FAC234"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B9AEB4"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#B455F0"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FB03D6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#03FBC7",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F3FB04",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#B455F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#02FB03"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FA2120"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#F3FB04"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FA2120"
      }
    }
  ],
  "semanticTokenColors": {
    "function": {
      "fontStyle": "italic"
    },
    "method": {
      "fontStyle": "italic"
    },
    "parameter": {
      "fontStyle": "italic"
    },
    "function.declaration": {
      "foreground": "#03FBC6",
      "fontStyle": "bold"
    },
    "method.declaration": {
      "foreground": "#03FBC6",
      "fontStyle": "bold"
    },
    "magicFunction.declaration": {
      "foreground": "#03FBC6",
      "fontStyle": "bold"
    },
    "decorator": {
      "foreground": "#03FBC7",
      "fontStyle": "italic"
    },
    "selfParameter": {
      "foreground": "#B9AEB4",
      "fontStyle": "italic"
    },
    "clsParameter": {
      "foreground": "#B9AEB4",
      "fontStyle": "italic"
    },
    "builtinConstant": {
      "foreground": "#F9E9B4"
    },
    "enumMember": {
      "foreground": "#FAC234"
    },
    "variable.readonly": {
      "foreground": "#F3FB04"
    },
    "module": {
      "foreground": "#B9AEB4"
    },
    "namespace": {
      "foreground": "#B9AEB4"
    }
  }
}
